<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox (#115), Mac App Store variant: the direct file minus the
	     Sparkle mach-lookup exceptions — the store owns updates, and
	     temporary-exception entitlements invite App Review questions. The
	     App Store identity keys (com.apple.application-identifier,
	     com.apple.developer.team-identifier) that Xcode would inject are
	     added at sign time by package-mas.sh, keeping this file free of
	     team-specific values. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- No network.client: nothing in the store build opens an outgoing
	     connection since the sync server (#272) and the Traggo import (#275)
	     went — CloudKit has its own entitlement, and updates are the
	     store's. The direct variant keeps the key for Sparkle. -->
	<!-- Powerbox: the JSON export writes to the NSSavePanel's chosen path. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- iCloud sync (#121, #244). Unlike the direct variant there is no
	     strip-when-unprovisioned path: a store build is always signed
	     against a Mac App Store profile (package-mas.sh requires one), so
	     the keys are unconditional. The environment is claimed explicitly —
	     the #238 lesson: an unclaimed environment leaves the choice to
	     cloudd's inference — and store builds are Production, always. -->
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.streetfortress.MomentTally</string>
	</array>
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>
</dict>
</plist>
