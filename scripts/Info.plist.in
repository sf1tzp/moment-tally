<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>MomentTally</string>
	<key>CFBundleIdentifier</key>
	<string>com.streetfortress.MomentTally</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Moment Tally</string>
	<key>CFBundleDisplayName</key>
	<string>Moment Tally</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@BUILD@</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<true/>
	<!-- Required for App Store submission, informative elsewhere (#115). -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Steven Fitzpatrick</string>
	<!-- Declarative export-compliance answer (HTTPS/CloudKit only — exempt),
	     so ASC never gates an upload on the manual questionnaire. Twin of
	     INFOPLIST_KEY_ITSAppUsesNonExemptEncryption in ios/project.yml. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Sparkle auto-update (#46). The feed URL is GitHub's stable
	     "latest release asset" redirect, so the appcast rides the same
	     release-publish step as the app archive itself. -->
	<key>SUFeedURL</key>
	<string>https://github.com/sf1tzp/moment-tally/releases/latest/download/appcast.xml</string>
	<!-- Public half of the EdDSA pair; the private half signs release
	     archives from the login keychain (generate_keys, see #45). -->
	<key>SUPublicEDKey</key>
	<string>scfyPgkFSQwklPlvpmhUAuGsRQ7O91RlZy/MDI7l/8c=</string>
	<!-- Background checks default on without Sparkle's second-launch
	     permission prompt; the Settings toggle is the opt-out. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- Sandboxed Sparkle (#115): turn on the bundled Installer.xpc, the
	     out-of-sandbox process that actually swaps the app on disk. Pairs
	     with the mach-lookup exceptions in MomentTally.entitlements. The
	     Downloader XPC stays off — the app holds network.client itself. -->
	<key>SUEnableInstallerLauncherService</key>
	<true/>
</dict>
</plist>
